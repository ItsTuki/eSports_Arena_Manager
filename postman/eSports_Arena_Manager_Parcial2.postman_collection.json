{
  "info": {
    "name": "eSports Arena Manager - Parcial 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "auth_url", "value": "http://localhost:8080/api/v1/auth" },
    { "key": "user_url", "value": "http://localhost:8081/api/v1/usuarios" },
    { "key": "team_url", "value": "http://localhost:8082/api/v1/equipos" },
    { "key": "tournament_url", "value": "http://localhost:8083/api/v1/torneos" },
    { "key": "registration_url", "value": "http://localhost:8084/api/v1/inscripciones" },
    { "key": "sanction_url", "value": "http://localhost:8085/api/v1/sanciones" },
    { "key": "match_url", "value": "http://localhost:8086/api/v1/partidas" },
    { "key": "game_url", "value": "http://localhost:8087/api/v1/juegos" },
    { "key": "result_url", "value": "http://localhost:8088/api/v1/resultados" },
    { "key": "ranking_url", "value": "http://localhost:8089/api/v1/rankings" },
    { "key": "prize_url", "value": "http://localhost:8090/api/v1/premios" },
    { "key": "notification_url", "value": "http://localhost:8091/api/v1/notificaciones" }
  ],
  "item": [
    { "name": "Crear usuario", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{user_url}}", "body": { "mode": "raw", "raw": "{\"nombre\":\"Admin Uno\",\"nickname\":\"admin1\",\"email\":\"admin@example.com\",\"rol\":\"ADMINISTRADOR\"}" } } },
    { "name": "Crear cuenta auth", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{auth_url}}/registro", "body": { "mode": "raw", "raw": "{\"email\":\"admin@example.com\",\"password\":\"Admin1234\",\"rol\":\"ADMINISTRADOR\"}" } } },
    { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{auth_url}}/login", "body": { "mode": "raw", "raw": "{\"email\":\"admin@example.com\",\"password\":\"Admin1234\"}" } } },
    { "name": "Crear juego", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{game_url}}", "body": { "mode": "raw", "raw": "{\"nombre\":\"Valorant\",\"genero\":\"FPS\",\"modalidad\":\"EQUIPO\",\"jugadoresPorEquipo\":5,\"reglasGenerales\":\"Bo3\"}" } } },
    { "name": "Crear torneo", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{tournament_url}}", "body": { "mode": "raw", "raw": "{\"nombre\":\"Copa Verano\",\"juegoId\":1,\"fechaInicio\":\"2026-06-01T10:00:00\",\"fechaFin\":\"2026-06-30T20:00:00\",\"fechaCierreInscripcion\":\"2026-05-28T23:59:00\",\"cupoMaximo\":16,\"modalidad\":\"EQUIPO\",\"estado\":\"ABIERTO\"}" } } },
    { "name": "Crear equipo", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{team_url}}", "body": { "mode": "raw", "raw": "{\"nombre\":\"Team Alpha\",\"capitanId\":1,\"juegoPrincipalId\":1}" } } },
    { "name": "Crear inscripción", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{registration_url}}", "body": { "mode": "raw", "raw": "{\"torneoId\":1,\"equipoId\":1,\"tipoParticipante\":\"EQUIPO\"}" } } },
    { "name": "Crear partida", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{match_url}}", "body": { "mode": "raw", "raw": "{\"torneoId\":1,\"participanteAId\":1,\"participanteBId\":2,\"ronda\":1,\"fechaHora\":\"2026-06-02T18:00:00\"}" } } },
    { "name": "Crear resultado", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{result_url}}", "body": { "mode": "raw", "raw": "{\"partidaId\":1,\"ganadorId\":1,\"puntajeA\":13,\"puntajeB\":8,\"evidencia\":\"url-demo\"}" } } },
    { "name": "Crear ranking", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{ranking_url}}", "body": { "mode": "raw", "raw": "{\"torneoId\":1,\"participanteId\":1}" } } },
    { "name": "Crear sanción", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{sanction_url}}", "body": { "mode": "raw", "raw": "{\"usuarioId\":1,\"motivo\":\"Conducta indebida\",\"fechaInicio\":\"2026-05-24\",\"fechaFin\":\"2026-06-24\",\"severidad\":\"BLOQUEANTE\"}" } } },
    { "name": "Crear premio", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{prize_url}}", "body": { "mode": "raw", "raw": "{\"torneoId\":1,\"posicion\":1,\"descripcion\":\"Medalla oro\",\"valor\":100000}" } } },
    { "name": "Crear notificación", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{notification_url}}", "body": { "mode": "raw", "raw": "{\"usuarioId\":1,\"tipo\":\"GENERAL\",\"mensaje\":\"Bienvenido al torneo\"}" } } }
  ]
}
